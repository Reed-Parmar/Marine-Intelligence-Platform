# .gitignore for CMLRE Marine Data Platform

# Environment variables
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
.venv/
venv/
env/
ENV/

# Node / Frontend dependencies and builds
node_modules/
dist/
build/
.npm/

# IDE / Editor configurations
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter / Notebook checkpoints
.ipynb_checkpoints/

# ML models and artifacts
models/
artifacts/

# Data directories
data/raw/
data/processed/

#dataset
dataset/
canonical_output/
_tmp_test/
pytest-cache-files-*/